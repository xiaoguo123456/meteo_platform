VITE_API_BASE_URL=/api
METEO_DATA_DIR=./data
METEO_CORS_ORIGINS=http://localhost:5173
# 默认严格读取 Open-Meteo S3；仅本地排查时可显式改为 api
WEATHER_SPATIAL_SOURCE=s3
WEATHER_BLOCK_CACHE=./data/cache/omfiles

# 预报预缓存目录默认为项目 data/cache/forecasts
WEATHER_POLL_SECONDS=300
WEATHER_DOWNLOAD_CONCURRENCY=4
WEATHER_S3_BLOCK_SIZE=262144
